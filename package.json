{
  "name": "@vladislavlad/opencode-v2-openspec-plugin",
  "version": "2.0.0",
  "description": "OpenSpec TUI sidebar plugin for opencode – browse specs, review change proposals, and drive the OpenSpec flow from the terminal.",
  "type": "module",
  "license": "MIT",
  "author": "Vladislav Kartashov",
  "homepage": "https://github.com/vladislavlad/opencode-openspec-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladislavlad/opencode-openspec-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/vladislavlad/opencode-openspec-plugin/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "openspec",
    "tui",
    "sidebar",
    "solid-js"
  ],
  "exports": {
    "./tui": "./dist/index.js"
  },
  "files": [
    "dist",
    "tui.js",
    "docs/v1.md",
    "docs/releasing.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "NODE_ENV=production bun run build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "bun test --preload @opentui/solid/preload",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.4.1 <3.0.0",
    "@opentui/core": "^0.9.4",
    "@opentui/solid": "^0.9.4",
    "solid-js": ">=1.9.12 <2.0.0"
  },
  "devDependencies": {
    "@babel/core": "7",
    "@babel/preset-typescript": "7",
    "@fission-ai/openspec": "2.2.0",
    "@opencode/plugin": "2.4.2",
    "@opencode/theme": "2.4.2",
    "@opentui/core": "0.9.9",
    "@opentui/solid": "0.9.9",
    "@types/bun": "^1.4.5",
    "@types/node": "^24.19.4",
    "babel-preset-solid": "^1.9.19",
    "gray-matter": "4.0.3",
    "oxlint": "^1.95.0",
    "solid-js": "1.9.17",
    "typescript": "^5.8.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "browserslist": "^4.29.6",
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
